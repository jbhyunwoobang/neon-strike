{
  "name": "neon-strike-server",
  "version": "1.0.0",
  "private": true,
  "description": "Authoritative Socket.IO game server for NEON STRIKE",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
